{
  "name": "@MLForge/MLForge-openclaw",
  "version": "0.2.0",
  "description": "OpenClaw integration package for MLForge Tracing",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLForge/MLForge.git"
  },
  "homepage": "https://MLForge.org/",
  "author": {
    "name": "MLForge",
    "url": "https://MLForge.org/"
  },
  "bugs": {
    "url": "https://github.com/MLForge/MLForge/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "MLForge",
    "tracing",
    "observability",
    "openclaw",
    "llm",
    "ai-agent",
    "javascript",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@MLForge/core": ">=0.2.0 || >=0.3.0-rc.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md"
  ]
}
